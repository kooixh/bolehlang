{
  "name": "bolehlang",
  "displayName": "bolehlang",
  "description": "Syntax highlighting for the bolehlang programming language",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "bolehlang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kooixh/bolehlang.git"
  },
  "contributes": {
    "languages": [
      {
        "id": "bolehlang",
        "aliases": [
          "bolehlang",
          "boleh"
        ],
        "extensions": [
          ".boleh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bolehlang",
        "scopeName": "source.boleh",
        "path": "./syntaxes/bolehlang.tmLanguage.json"
      }
    ]
  }
}
