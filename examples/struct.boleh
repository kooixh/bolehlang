kroni Orang {
    nama,
    umur,
    pekerjaan
}

dei ali = Orang("Ali" , 25 , "Software Engineer");


eh "Nama: " + ali.nama;
eh "Umur: " + ali.umur;
eh "Pekerjaan: " + ali.pekerjaan + "\n";

tukar ali.umur = 26
tukar ali.pekerjaan = "Data Scientist"

eh "Nama: " + ali.nama;
eh "Umur: " + ali.umur;
eh "Pekerjaan: " + ali.pekerjaan;




